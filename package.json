{
  "name": "contrast-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:next": "bun run --filter @contrast-check/next dev",
    "dev:nuxt": "bun run --filter @contrast-check/nuxt dev",
    "build": "bun run --filter @contrast-check/next --filter @contrast-check/nuxt build",
    "lint": "biome check",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter @contrast-check/core test",
    "test:e2e": "playwright test",
    "screenshots": "bun run --filter @contrast-check/next build && bun scripts/screenshots.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "typescript": "^7.0.2"
  }
}
